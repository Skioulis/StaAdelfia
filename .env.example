# Copy to .env and fill in:  cp .env.example .env
# With Docker, NODE_ENV, DATA_DIR, HOST and PORT are fixed in docker-compose.yml.
# For local development (npm run dev) use NODE_ENV=development, DATA_DIR=./data, SEED_SAMPLE_DATA=true.

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# menu.db and uploads/ ( /data in Docker, ./data in development )
DATA_DIR=/data

ADMIN_USERNAME=admin
# Run: npm run hash-password   and paste the line it prints (keep the single quotes).
ADMIN_PASSWORD_HASH=

# Sample menu on an empty database. Development only; ignored in production.
SEED_SAMPLE_DATA=false

# Proxy hops in front of the app (nginx = 1). Avoid "true": it lets clients fake their IP.
TRUST_PROXY=1
