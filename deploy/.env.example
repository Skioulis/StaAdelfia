# Copy to .env next to docker-compose.yml:  cp .env.example .env

# Admin login for /admin
ADMIN_USERNAME=admin
# Make the hash with:
#   docker run --rm -it skioulis/gyros-menu:latest node src/scripts/hash-password.js
# and paste the line it prints here (keep the single quotes; the hash contains $ signs).
ADMIN_PASSWORD_HASH=

# Proxies in front of the app: nginx = 1. Do not use "true".
TRUST_PROXY=1

# Must stay false in production.
SEED_SAMPLE_DATA=false

# Optional: pin a version instead of "latest", e.g. skioulis/gyros-menu:1.0.0
# GYROS_IMAGE=skioulis/gyros-menu:1.0.0
